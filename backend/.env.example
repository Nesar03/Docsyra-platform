# Server Port
PORT=4000

# MongoDB Connection String (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net)
MONGODB_URI=

# Cloudinary Image Hosting Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Master Credentials (used to log in as Admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword

# JWT Secret Key for token signing
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend and Admin URLs for CORS (comma-separated, leave blank to allow all during local testing)
# Example: https://docsyra-frontend.vercel.app,https://docsyra-admin.vercel.app
CORS_ORIGINS=
